<IfModule mod_rewrite.c>
    RewriteEngine On

    # Prevent direct access to sensitive system files and folders
    RewriteRule ^\.env$ - [F,L,NC]
    RewriteRule ^composer\.(json|lock)$ - [F,L,NC]
    RewriteRule ^package(-lock)?\.json$ - [F,L,NC]
    RewriteRule ^(app|bootstrap|config|database|storage|tests|vendor)(/.*)?$ - [F,L,NC]

    # Rewrite all public traffic to the public/ directory
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
